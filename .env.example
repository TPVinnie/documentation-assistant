# Copy to .env and adjust as needed. No secrets are required for the default local stack.

# --- Paths ---
DOCS_ASSISTANT_DATA_DIR=./data
DOCS_ASSISTANT_DOCUMENTS_DIR=./data/sample_documents
DOCS_ASSISTANT_INDEX_DIR=./data/index

# --- Embeddings ---
DOCS_ASSISTANT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Generation backend ---
# "ollama" for local generation via an Ollama server, "mock" for a deterministic
# offline stub used in tests/CI (no network, no model download required).
DOCS_ASSISTANT_LLM_PROVIDER=ollama
DOCS_ASSISTANT_OLLAMA_HOST=http://localhost:11434
DOCS_ASSISTANT_OLLAMA_MODEL=llama3.2:3b

# --- Security / resource limits ---
DOCS_ASSISTANT_MAX_FILE_SIZE_MB=25

# --- Reranking ---
DOCS_ASSISTANT_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
DOCS_ASSISTANT_USE_RERANKER=true

# --- Retrieval defaults (overridable per-request / per eval config) ---
DOCS_ASSISTANT_TOP_K_DENSE=20
DOCS_ASSISTANT_TOP_K_LEXICAL=20
DOCS_ASSISTANT_TOP_K_FUSED=10
DOCS_ASSISTANT_TOP_K_FINAL=5
DOCS_ASSISTANT_USE_HYBRID=true

# --- Context / generation budget ---
DOCS_ASSISTANT_MAX_CONTEXT_CHARS=6000

# --- Abstention thresholds (heuristic, not calibrated probabilities) ---
DOCS_ASSISTANT_MIN_EVIDENCE_SCORE=0.15
DOCS_ASSISTANT_MIN_CITATION_COVERAGE=0.3

# --- API ---
DOCS_ASSISTANT_API_HOST=0.0.0.0
DOCS_ASSISTANT_API_PORT=8000

# --- Logging ---
DOCS_ASSISTANT_LOG_LEVEL=INFO
